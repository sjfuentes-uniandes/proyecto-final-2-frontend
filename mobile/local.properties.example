# Copie este archivo a local.properties (gitignored) y ajuste los valores.
sdk.dir=/ruta/al/Android/Sdk

# bff-movil corriendo en local (docker compose del repo back); 10.0.2.2 es como el emulador
# de Android ve el localhost de la maquina anfitriona. En un dispositivo fisico use la IP de
# su maquina en la red local.
bffMovilBaseUrl=http://10.0.2.2:8081/

# Pool clientes de Cognito, app client mobile (ver infra/platform/identity.tf del repo back
# o "terraform output cognito"). Sin estos valores la app arranca pero el ingreso con
# credenciales/biometria falla con un error claro en vez de bloquear el arranque.
cognitoPoolId=
cognitoClientId=
cognitoRegion=us-east-1

# --- Solo builds debug contra el backend local (docker compose); ignorados en release ---
# El backend local no usa Cognito: identifica al titular por X-Authenticated-Sub. Use un texto
# distinto por cada persona de prueba. Déjelo vacío al apuntar a AWS.
subLocal=persona-de-prueba-1
# Con subLocal el registro omite Cognito: valida el tokenRegistro con /v1/registro/validaciones y
# vincula con ese sub. Para probar SignUp real contra AWS, deje subLocal vacío y complete cognito*.
# El simulador de KYC local decide el resultado por el TEXTO de la selfie y no reconoce una imagen
# real (devolvería 503). Si se indica, la app envía este texto en lugar de la foto. Valores:
#   selfie-sintetica-aprobada | selfie-sintetica-captura-invalida | selfie-sintetica-rechazada
#   selfie-sintetica-caida    | selfie-sintetica-lenta
# Déjelo vacío para enviar la imagen real (p. ej. contra AWS).
selfieDePruebaLocal=selfie-sintetica-aprobada
