<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada de la app se respalda ni se transfiere a otro dispositivo. Aunque la selfie nunca se guarda
  en disco, se excluye todo de forma explícita: en Android 12+ `allowBackup="false"` por sí solo no
  cubre la transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
