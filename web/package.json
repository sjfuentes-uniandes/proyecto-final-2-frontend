{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage && node scripts/cobertura-feature.mjs",
    "lint:consentimientos": "eslint src/app/features/consentimientos",
    "lint:contratacion": "eslint src/app/features/contratacion",
    "e2e": "playwright test",
    "test:pact": "playwright test -c pact/playwright.config.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "aws-amplify": "^6.22.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular/cli": "^19.2.4",
    "@angular/compiler-cli": "^19.2.0",
    "@axe-core/playwright": "~4.13.0",
    "@pact-foundation/pact": "~17.1.4",
    "@playwright/test": "~1.63.0",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "^19.8.1",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "scarfSettings": {
    "enabled": false
  },
  "overrides": {
    "playwright-core": "~1.63.0"
  }
}
